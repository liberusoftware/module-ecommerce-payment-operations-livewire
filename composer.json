{
    "name": "liberusoftware/ecommerce-payment-operations-livewire",
    "description": "Livewire 4 shopper-facing surface for liberusoftware/ecommerce-payment-operations: a provider-neutral pay control whose amount comes from the server, a receipt folded from the ledger, and saved instruments a customer can list and remove but never add.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-payment-operations"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "liberusoftware/ecommerce-payment-operations": "^0.1"
    },
    "require-dev": {
        "liberusoftware/ecommerce-payment-operations": "^0.1",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\PaymentOperations\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\PaymentOperations\\Livewire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-payment-operations-livewire"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
